{
  "name": "zodiac-remotion",
  "version": "1.0.0",
  "description": "Zodiac Video Engine",
  "scripts": {
    "start": "remotion preview src/index.tsx",
    "build": "remotion render src/index.tsx ZodiacVideo out/video.mp4 --props=./input.json --gl=swangle --concurrency=1 --timeout=180000 --log=verbose",
    "test": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@remotion/cli": "4.0.120",
    "@remotion/player": "4.0.120",
    "@remotion/transitions": "4.0.120",
    "@remotion/zod-types": "4.0.120",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.120",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "18.2.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
